# Configuration Firebase — copiez ce fichier en `.env` et remplissez avec les
# valeurs de votre projet (Console Firebase > Paramètres du projet > Vos applications > Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optionnel — génération de concepts d'avatars 3D (scripts/tripo-avatar-concepts.mjs).
# Usage hors ligne uniquement : ne JAMAIS préfixer par EXPO_PUBLIC_ (la clé serait
# embarquée dans l'app et extractible par n'importe qui).
TRIPO_API_KEY=
